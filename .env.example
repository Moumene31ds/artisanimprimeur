# ============================================================
# L'Artisan Imprimeur — Environment variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ---------- AI (free tier only — no Gemini, no paid APIs) ----------
# Provider selection: auto | ollama | openrouter
AI_PROVIDER=auto
# Ollama (local, 100% free). Leave as-is if Ollama is installed locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Vision model used for image uploads / receipt OCR via Ollama.
OLLAMA_VISION_MODEL=qwen3-vl:latest
# OpenRouter free key (https://openrouter.ai — no credit card needed).
# Cloud fallback when Ollama is unreachable (e.g. Vercel).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Vision model used for receipt OCR via OpenRouter.
OPENROUTER_VISION_MODEL=

# ---------- Image generation (AI Studio designs) ----------
# Provider selection: auto | together | replicate | fal | pollinations
# auto tries, in order: Together AI (FLUX free) → Replicate → fal.ai → Pollinations.
IMAGE_PROVIDER=auto
# Together AI — FLUX.1-schnell-free (free tier, https://api.together.xyz)
TOGETHER_API_KEY=
# Replicate — black-forest-labs/flux-schnell (https://replicate.com)
REPLICATE_API_TOKEN=
# fal.ai — fal-ai/flux/schnell (https://fal.ai)
FAL_KEY=
# Pollinations.ai — free API key from https://enter.pollinations.ai.
# Optional but recommended: with a key we use the modern gen.pollinations.ai
# endpoint which honors model=flux (real FLUX.1, high quality + Arabic prompts).
# Without a key we fall back to the legacy image.pollinations.ai endpoint, which
# silently serves the low-quality "sana" model and mangles non-Latin prompts.
POLLINATIONS_API_KEY=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=https://artisanimprimeur.vercel.app
NEXT_PUBLIC_SITE_URL=https://artisanimprimeur.vercel.app
NEXT_PUBLIC_CONTACT_PHONE=+213549179000
NEXT_PUBLIC_AUTH_TEST_MODE=false

# ---------- Firebase (Web SDK, public keys) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------- Firebase (Admin / server-side) ----------
FIREBASE_SERVICE_ACCOUNT=

# ---------- Cloudinary (image upload + AI Studio design storage) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---------- Web Push (VAPID) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:imprimeurlartisan@gmail.com

# ---------- WhatsApp Business API ----------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_VERIFY_TOKEN=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=L'Artisan Imprimeur <onboarding@resend.dev>

# ---------- Analytics / Marketing ----------
META_PIXEL_ID=
META_ACCESS_TOKEN=
GA4_MEASUREMENT_ID=

# ---------- Upstash Redis (rate limiting at the edge) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Security ----------
CRON_SECRET=
ADMIN_EMAILS=
CORS_ALLOWED_ORIGINS=https://artisanimprimeur.vercel.app
CSP_POLICY=
